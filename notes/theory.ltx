\]
\justifies
\ups \nar \Gamma \wprov   (\epair {q} {q'})\ (\gg(x: \nar A).\nar R\ x)\ (\bglue(\nar a, \nar a')) : \gg(x: \nar A).\nar R\ x
\]
\justifies
\nar \Gamma \nprov  \bunglue((\epair {q} {q'})\ (\gg(x: \nar A).\nar R\ x)\ (\bglue(\nar a, \nar a'))) : \nar R\ (q\ \nar A\ \nar a)
