\section{Semantics}
We imagine the target language of our `semantics' to be ordinary dependent type theory
with no exotic contexts or types or terms.
We define operations $\dash^*$ and $\sem\dash$ and $\tsem\dash\dash$ so that syntactically:

\begin{tabular}{l}
If $\wid \Gamma$ is a wide context, then ${\wid \Gamma}^*$ is a context.\\
If $\wid A$ is a wide type, then ${\wid A}^*$ is a type.\\
If $\wid M$ is a wide term, then ${\wid M}^*$ is a term.
If $\wid \Gamma$ is a wide context, then $\sem{\wid \Gamma}$ is a context.\\
If $\wid A$ is a wide type and $M$ is a term, then $\tsem {\wid A} {M}$ is a type.\\
If $\wid M$ is a wide term, then $\sem{\wid M}$ is a term.\\
If $\nar \Gamma$ is a narrow context, then ${\nar \Gamma}^*$ is a context.\\
If $\nar A$ is a narrow type, then ${\nar A}^*$ is a type.\\
If $\nar M$ is a narrow term, then ${\nar M}^*$ is a term.
\end{tabular}

\noindent Furthermore we wish to prove that these operations preserve typing:

\begin{lemma}[Type Semantic Soundness]\ %
\label{semantic.soundness.type}
  \begin{enumerate}[noitemsep]
\item If ${\wid\Gamma} \wprov {\wid A} : \rtype$, then ${\wid\Gamma}^* \prov {\wid A}^* : \rtype$.
\item If ${\wid\Gamma} \wprov {\wid A} : \rtype$, then $\sem {\wid\Gamma}, x : \wid {\wid A}^* \prov \tsem {\wid A} x : \rtype$.
\item If ${\nar\Gamma} \nprov {\nar A} : \rtype$, then ${\nar\Gamma}^* \prov {\nar A}^* : \rtype$.
  \end{enumerate}
\end{lemma}

\begin{lemma}[Term Semantic Soundness]\ %
\label{semantic.soundness.term}
  \begin{enumerate}[noitemsep]
\item If ${\wid\Gamma} \wprov {\wid M} : {\wid A}$, then ${\wid\Gamma}^* \prov {\wid M}^* : {{\wid A}}^*$.
\label{semantic.soundness.wide.term.star}
\item If ${\wid\Gamma} \wprov {\wid M} : {\wid A}$, then $\sem{\wid\Gamma} \prov \sem {\wid M} : \tsem {\wid A} {\wid M^*}$.
\label{semantic.soundness.wide.term.brackets}
\item If ${\nar\Gamma} \nprov {\nar M} : {\nar A}$, then ${\nar\Gamma}^* \prov {\nar M}^* : {{\nar A}}^*$.
\label{semantic.soundness.narrow.term.star}
  \end{enumerate}
\end{lemma}

\begin{proof}
Distributed throughout various sections.
\cqed
\end{proof}

\begin{lemma}
\label{erase.star.eq.star}
$\erase{\wid A}^* = \wid A^*$
\end{lemma}



Context Semantics:
\[
\begin{array}{rcl}
({\wid\Gamma}, x : \wid A)^* &=& ({\wid\Gamma}^*, x^* : {\wid A}^*)\\
({\wid\Gamma}, x :: \wid A)^* &=& ({\wid\Gamma}^*, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*})\\
({\wid\Gamma}, x \div \nar A)^* &=& ({\wid\Gamma}^*, x^* : {\nar A}^*)\\
\end{array}
\qquad
\begin{array}{rcl}
\sem{{\wid\Gamma}, x : \wid A} &=& (\sem{\wid\Gamma}, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*})\\
\sem{{\wid\Gamma}, x :: \wid A} &=& (\sem{\wid\Gamma}, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*})\\
\sem{{\wid\Gamma}, x \div \nar A} &=& (\sem{\wid\Gamma}, x^* : {\nar A}^*)\\
\end{array}
\]
\[
\begin{array}{rcl}
({\nar\Gamma}, x :: \wid A)^* &=& ({\nar\Gamma}^*, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*})\\
({\nar\Gamma}, x \div \nar A)^* &=& ({\nar\Gamma}^*, x^* : {\nar A}^*)\\
\end{array}
\]




\begin{lemma}
\label{semantic.weakening}
For any $\wid \Gamma$, the context ${\wid \Gamma}^*$ is a subset of $\sem{\wid \Gamma}$.
Therefore any judgment that holds in context in ${\wid \Gamma}^*$ also holds in
$\sem{\wid \Gamma}$.
\end{lemma}

\begin{lemma}
\label{include.brackets.eq.star}
$\sem{\ups \nar \Gamma} = \nar \Gamma^*$
\end{lemma}

\begin{lemma}
\label{include.star.eq.star}
$(\ups \nar \Gamma)^* = \nar \Gamma^*$
\end{lemma}


\begin{lemma}
\label{demote.star.eq.star}
$(\demote{\wid \Gamma})^* = \wid \Gamma^*$
\end{lemma}

\begin{lemma}
\label{promote.star.eq.brackets}
$(\promote{\wid \Gamma})^* = \sem{ \wid \Gamma}$
\end{lemma}

\begin{proof}
By induction on $\wid \Gamma$, using Lemma~\ref{erase.star.eq.star}.
\cqed
\end{proof}


\begin{lemma}[Context Semantic Soundness]\ %
\label{semantic.soundness.context}
  \begin{enumerate}[noitemsep]
\item If $\wprov {\wid\Gamma}\rctx$, then $\prov {{\wid\Gamma}}^*\rctx$.
\item If $\wprov {\wid\Gamma}\rctx$, then $\prov \sem{{\wid\Gamma}}\rctx$.
\item If $\nprov {\nar\Gamma}\rctx$, then $\prov {{\nar\Gamma}}^*\rctx$.
  \end{enumerate}
\end{lemma}


\begin{proof}\ %
\begin{itemize}
\item
We know
\[
\begin{prooftree}
\wprov {\wid\Gamma} \rctx \qquad {\wid\Gamma} \wprov \wid A : \rtype
\justifies
\wprov ({\wid\Gamma}, x : \wid A)\rctx
\end{prooftree}
\]
and therefore
\[\prov \wid\Gamma^* \rctx \qquad \prov \sem{\wid\Gamma} \rctx\]
\[\wid\Gamma^* \prov \wid A^*:\rtype \qquad \sem{\wid\Gamma}, x^* : \wid A^* \prov \tsem{\wid A}{x^*} \]
which is enough to show
\[\prov ({\wid\Gamma}^*, x^* : {\wid A}^*) \rctx\qquad
\prov(\sem{\wid\Gamma}, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*}) \rctx\]
\item
We know
\[
\begin{prooftree}
\wprov {\wid\Gamma} \rctx \qquad \demote {\wid \Gamma} \nprov \nar A : \rtype
\justifies
\wprov ({\wid\Gamma}, x \div \nar A)\rctx
\end{prooftree}
\]
and therefore
\[\prov \wid\Gamma^* \rctx \qquad \prov \sem{\wid\Gamma} \rctx\]
\[(\demote{\wid\Gamma})^* \prov \nar A^*:\rtype \]
which is enough to show (using Lemma~\ref{semantic.weakening} and Lemma~\ref{demote.star.eq.star})
\[\prov ({\wid\Gamma}^*, x^* : {\nar A}^*) \rctx\qquad
\prov(\sem{\wid\Gamma}, x^* : {\nar A}^*) \rctx\]
\item
We know
\[
\begin{prooftree}
\wprov {\wid\Gamma} \rctx \qquad \rdemote{\wid\Gamma} \wprov \wid A : \rtype
\justifies
\wprov ({\wid\Gamma}, x :: \wid A)\rctx
\end{prooftree}
\]
and therefore
\[\prov \wid\Gamma^* \rctx \qquad \prov \sem{\wid\Gamma} \rctx\]
\[(\rdemote{\wid\Gamma})^* \prov \wid A^*:\rtype \qquad \sem{\rdemote{\wid\Gamma}}, x^* : \wid A^* \prov \tsem{\wid A}{x^*} \]
using Lemmas \ref{include.brackets.eq.star}, \ref{include.star.eq.star}, and~\ref{demote.star.eq.star} this is the same as
\[\wid\Gamma^* \prov \wid A^*:\rtype \qquad \wid\Gamma^*, x^* : \wid A^* \prov \tsem{\wid A}{x^*} \]
which is enough to show (also using Lemma~\ref{semantic.weakening})
\[\prov ({\wid\Gamma}^*, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*}) \rctx\qquad
\prov(\sem{\wid\Gamma}, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*}) \rctx\]
\item
We know
\[
\begin{prooftree}
\nprov {\nar\Gamma} \rctx \qquad {\nar\Gamma} \nprov \nar A : \rtype
\justifies
\nprov ({\nar\Gamma}, x \div \nar A)\rctx
\end{prooftree}
\]
and therefore
\[\prov \nar\Gamma^* \rctx \qquad \nar\Gamma^* \prov \nar A^*:\rtype \]
which is enough to show
\[\prov ({\nar\Gamma}^*, x^* : {\nar A}^*) \rctx\]
\item
We know
\[
\begin{prooftree}
\nprov {\nar\Gamma} \rctx \qquad \ups {\nar\Gamma} \wprov \wid A : \rtype
\justifies
\nprov ({\nar\Gamma}, x :: \wid A)\rctx
\end{prooftree}
\]
and therefore
\[\prov \nar\Gamma^* \rctx \]
\[ (\ups\nar\Gamma)^* \prov \wid A^*:\rtype \qquad \sem{\ups\nar\Gamma}, x^* : \wid A^* \prov \tsem{\wid A}{x^*} \]
Using Lemmas~\ref{include.brackets.eq.star} and~\ref{include.star.eq.star} we get
\[ \nar\Gamma^* \prov \wid A^*:\rtype \qquad \nar\Gamma^*, x^* : \wid A^* \prov \tsem{\wid A}{x^*} \]
which is enough to show
\[\prov ({\nar\Gamma}^*, x^* : {\wid A}^*, \sem x : \tsem {\wid A} {x^*}) \rctx\]
\end{itemize}
\cqed
\end{proof}

\subsection{Variable Semantics}
For the semantics we must check cases of \ref{semantic.soundness.term}. This is mostly straightforward, though
we need to invoke Lemma~\ref{erase.star.eq.star}.


\subsubsection{Fiber Type Semantics}
\[\begin{array}{rcl}
{\pp {\nar M} {\wid A}}^* &=& \tsem {\wid A} {\nar M^*}\\
\{\wid M\}^* &=& \sem {\wid M}\\
(\epair {\nar M} {\nar N})^* &=& {\nar M}^*\\
\end{array}
\qquad
\begin{array}{rcl}
\\
\\
\sem{\epair {\nar M}{\nar N}} &=& {\nar N}^*\\
\end{array}\]

Let's check that these are semantically sound.
In the formation rule, we know
\[\sem{\ups\nar\Gamma}, x : \wid A^* \prov \tsem{\wid A}{x} : \rtype\]
\[\nar\Gamma^* \prov \nar M^* : \erase{\wid A}^*\]
Lemma~\ref{erase.star.eq.star} and Lemma~\ref{include.brackets.eq.star} says these are
\[\nar\Gamma^*, x : \wid A^* \prov \tsem{\wid A}{x} : \rtype\]
\[\nar\Gamma^* \prov \nar M^* : \wid A^*\]
So substitute:
\[\nar\Gamma^* \prov \tsem{\wid A}{\nar M^*} : \rtype\]

For introduction, we must show
\[\nar \Gamma^* \prov \{\wid M\}^* : {\pp  {\erase{\wid M}} {\wid A}}^*\]
so
\[\nar \Gamma^* \prov \sem{\wid M} : \tsem{\wid A}{\wid M^*}\]
but this is exactly what we get out of the premise.

For elimination, we get from the premises (by Lemmas~\ref{demote.star.eq.star} and~\ref{promote.star.eq.brackets})
that
\[\wid\Gamma^* \prov \nar M^* : \wid A^* \]
\[\sem{\wid\Gamma} \prov \nar N^* : \tsem{\wid A}{\nar M^*}\]
and this is exactly what we need.



\subsubsection{Glue Type Semantics}
\[\begin{array}{rcl}
(\gg(x : \nar A).\nar B)^* &=& \nar A^*\\
\bglue(\nar M,\nar N)^* &=& \nar M^*\\
(\bunglue \wid M)^* &=& \sem{\wid M}\\
\end{array}
\qquad
\begin{array}{rcl}
\tsem{\gg(x : \nar A).\nar B}{M} &=& [M/x^*]\nar B^*\\
\sem{\bglue(\nar M,\nar N)} &=& \nar N^*\\
\\
\end{array}\]

Let's check that these are semantically sound.
In the formation rule, we know
\[ \wid\Gamma^* \prov \nar A^* : \rtype \]
\[ \sem{\wid\Gamma}, x^* : \nar A^* \prov \nar B^* : \rtype \]
which is exactly what we need to show.

For introduction, we know
\[ \wid\Gamma^* \prov \nar M^* : \nar A^*  \]
\[ \sem{\wid\Gamma} \prov \nar N^* : [\nar M^*/x^*]\nar B^* \]
which is exactly what we need to show.

For elimination, we know
\[\nar\Gamma^* \prov \sem{\wid M} : [\wid M^*/x^*]\nar B^*\]
which is exactly what we need to show.




\begin{lemma}[Semantics of Substitution]\ %
 \begin{enumerate}
  \item $([\wid M/x]\wid J)^* = [\wid M^* /x^*]\wid J^*$.
  \item $\sem {[\wid M/x]\wid J} =  [\sem{\wid M} /\sem x][\wid M^* /x^*]\sem{\wid J}$.
  \item $([\wid M/_{::}x]\wid J)^* = [\sem{\wid M} /\sem x][\wid M^* /x^*]\wid J^*$.
  \item $\sem {[\wid M/_{::}x]\wid J} =  [\sem{\wid M} /\sem x][\wid M^* /x^*]\sem{\wid J}$.
  \item $([\nar M/_{\div}x]\wid J)^* = [\nar M^* /x^*]\wid J^*$.
  \item $\sem {[\nar M/_{\div}x]\wid J} =  [\nar M^* /x^*]\sem{\wid J}$.
  \item $([\wid M/_{::}x]\nar J)^* = [\sem{\wid M} /\sem x][\wid M^* /x^*]\nar J^*$.
  \item $([\nar M/_{\div}x]\nar J)^* = [\nar M^* /x^*]\nar J^*$.
  \end{enumerate}
\end{lemma}

\begin{proof}

\cqed
\end{proof}

\subsection{The Amazing Right Adjoint}
\subsubsection{Definitions}
\def\TT{\mathbb{T}}
Define
\[\T = \gg(x\div 1).0\]
\[\surd \wid A = \gg(x\div ((\nar a\div \erase {\wid A}) \x \pp {\nar a} {\wid A})).1\]
\[\isurd \wid M = \bglue(\langle \erase{\wid M}, \{\wid M\}\rangle, \langle\rangle)\]
\[\esurd (t.\wid M) = \epair{[\langle\rangle/t] |\wid M|.1}{[\langle\rangle/t]|\wid M|.2}\]
We can justify some derived rules
\[
\begin{prooftree}
\rdemote{\wid\Gamma} \wprov \wid A : \wid\rtype
\justifies
\wid\Gamma \wprov \surd \wid A : \wid\rtype
\end{prooftree}
\qquad
\begin{prooftree}
\rdemote{\wid\Gamma} \wprov \wid M : \wid A
\justifies
\wid\Gamma \wprov \isurd \wid M : \surd \wid A
\end{prooftree}
\qquad
\begin{prooftree}
{\wid\Gamma}, t : \TT \wprov \wid M : \surd \wid A
\justifies
\wid\Gamma \wprov \esurd(t. \wid M) : \wid A
\end{prooftree}
\]
via
\[
\begin{prooftree}
\[
\[
\justifies
\demote{\wid\Gamma} \nprov  \erase {\wid A} : \nar\rtype
\]
\[
\rdemote{\wid\Gamma} \wprov \wid A : \wid\rtype
\qquad
\[
\justifies
\demote{\wid\Gamma}, \nar a \div \erase{\wid A} \nprov  \nar a : \erase{\wid A}
\]
\justifies
\demote{\wid\Gamma}, \nar a \div \erase{\wid A} \nprov \pp {\nar a} {\wid A} : \nar\rtype
\]
\justifies
\demote{\wid\Gamma} \nprov ((\nar a\div \erase {\wid A}) \x \pp {\nar a} {\wid A}) : \nar\rtype
\]
\[\justifies \promote{\wid\Gamma} \nprov  1 : \nar\rtype\]
\justifies
\wid\Gamma \wprov \gg(x\div ((\nar a\div \erase {\wid A}) \x \pp {\nar a} {\wid A})).1 : \wid\rtype
\end{prooftree}
\]
and
\[
\begin{prooftree}
\[
\[
\justifies
\demote{\wid\Gamma} \nprov \erase{\wid M} : \erase {\wid A}
\]
\[
\rdemote{\wid\Gamma} \wprov \wid M : \wid A
\justifies
\demote{\wid\Gamma} \nprov  \{\wid M\} : \pp {\erase {\wid M}} {\wid A}
\]
\justifies
\demote{\wid\Gamma} \nprov \langle \erase{\wid M}, \{\wid M\}\rangle : ((\nar a\div \erase {\wid A}) \x \pp {\nar a} {\wid A})
\]
\[
\justifies
\promote{\wid\Gamma} \nprov \langle\rangle : 1
\]
\justifies
\wid\Gamma \wprov \bglue(\langle \erase{\wid M}, \{\wid M\}\rangle, \langle\rangle) : \gg(x\div ((\nar a\div \erase {\wid A}) \x \pp {\nar a} {\wid A})).1
\end{prooftree}
\]
and
\[
\begin{prooftree}
\[
\justifies
\demote{\wid\Gamma} \nprov [\langle\rangle/t] |\wid M|.1 : \erase{\wid A}
\]
\[
\justifies
\promote{\wid\Gamma} \nprov [\langle\rangle/t]|\wid M|.2 : \pp{ [\langle\rangle/t]|\wid M|.1}{\wid A}
\]
\justifies
\wid\Gamma \wprov \epair{[\langle\rangle/t] |\wid M|.1}{[\langle\rangle/t]|\wid M|.2} : \wid A
\end{prooftree}
\]
\subsubsection{Adjunction}
Observe that
\[
\begin{prooftree}
\[
\justifies
y \div \erase{\wid A}, t \div 1 \nprov y : \erase{\wid A}
\]
\[
\[
\[
\justifies
y \div \erase{\wid A}, t :: \T \wprov t : \gg(x\div 1).0
\]
\justifies
y \div \erase{\wid A}, t :: \T \nprov \bunglue(t) : 0
\]
\justifies
y \div \erase{\wid A}, t :: \T \nprov \babort(\bunglue(t)) : \pp y {\wid A}
\]
\justifies
y \div \erase{\wid A}, t : \T \wprov \epair {y} {\babort(\bunglue(t))} : \wid A
\end{prooftree}
\]
So let's define $\key^t(y) = \epair {y} {\babort(\bunglue(t))}$ so that we have
\[
\begin{prooftree}
\justifies
y \div \erase{\wid A}, t : \T \wprov \key^t(y) : \wid A
\end{prooftree}
\]

Suppose we have
\[ x : \T \to \wid A \prov \wid M : \wid B\]
we can then construct
\[
\begin{prooftree}
\[
\justifies
 y \div  \erase{\wid A} \prov [\lambda t . \key^t(y)/x]\wid M : \wid B
\]
\justifies
 y :  \wid A \prov \isurd ( [\lambda t . \key^t(y)/x]\wid M): \surd \wid B
\end{prooftree}
\]

and conversely if we have a
\[ y :  \wid A \prov \wid N : \surd \wid B\]
then we can construct
\[
\begin{prooftree}
\[
\justifies
 x : \T \to \wid A, t : \T \prov [x\ t/y]\wid N : \surd \wid B
\]
\justifies
 x : \T \to \wid A \prov \esurd(t. [x\ t/y]\wid N) : \wid B
\end{prooftree}
\]

Let's try round trips. Let's first expand out
\[\wid M  :=  \esurd(t. [x\ t/y]\wid N)\]
\[\wid N  :=   \isurd ( [\lambda t . \key^t(y)/x]\wid M)\]
to
\[\wid M  :=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{|[x\ \langle\rangle/y]\wid N|.2}   \]
\[\wid N  :=   \bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ [\lambda t . \epair{y}{\babort(\bunglue(t))}/x]\wid M\}\rangle, \langle\rangle) \]

Here's the round trip for $\wid M$:
\[\wid M  :=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{|[x\ \langle\rangle/y]\wid N|.2}   \]
\[=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{|[x\ \langle\rangle/y](\bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ [\lambda t . \epair{y}{\babort(\bunglue(t))}/x]\wid M\}\rangle, \langle\rangle))|.2}   \]
\[=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{|(\bglue(\langle  [\lambda t . (x\ \langle\rangle)/x]\erase{\wid M}, \{ [\lambda t . \epair{x\ \langle\rangle}{\babort(\bunglue(t))}/x]\wid M\}\rangle, \langle\rangle))|.2}   \]
\[=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{(\langle  [\lambda t . (x\ \langle\rangle)/x]\erase{\wid M}, \{ [\lambda t . \epair{x\ \langle\rangle}{\babort(\bunglue(t))}/x]\wid M\}\rangle).2}   \]
\[=  \epair{ |[x\ \langle\rangle/y]\wid N|.1}{ \{ [\lambda t . \epair{x\ \langle\rangle}{\babort(\bunglue(t))}/x]\wid M\}}   \]
\[\equiv_{\eta}    [\lambda t . \epair{x\ \langle\rangle}{\babort(\bunglue(t))}/x]\wid M  \]
\[\equiv_{\eta}^0   [\lambda t . \epair{x\ \langle\rangle}{\{x\ t\}}/x]\wid M  \]
\[\equiv_{\beta}^{\pp{x\ t}{\wid A}}   [\lambda t . x\ t/x]\wid M  \]
\[\equiv_{\eta}^{\T \to \wid A}    [x/x]\wid M   \]

Here's the round trip for $\wid N$:
\[\wid N  :=   \bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ [\lambda t . \epair{y}{\babort(\bunglue(t))}/x]\wid M\}\rangle, \langle\rangle) \]
\[ = \bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ [\lambda t . \epair{y}{\babort(\bunglue(t))}/x](\epair{ |[x\ \langle\rangle/y]\wid N|.1}{|[x\ \langle\rangle/y]\wid N|.2})\}\rangle, \langle\rangle) \]
\[ = \bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ (\epair{ |[y/y]\wid N|.1}{|[y/y]\wid N|.2})\}\rangle, \langle\rangle) \]
\[ = \bglue(\langle  [\lambda t . y/x]\erase{\wid M}, \{ \epair{ |\wid N|.1}{|\wid N|.2}\}\rangle, \langle\rangle) \]
\[ = \bglue(\langle  [\lambda t . y/x]\erase{\wid M},  {|\wid N|.2}\rangle, \langle\rangle) \]
\[ = \bglue(\langle  \erase{\wid N}.1,  {|\wid N|.2}\rangle, \langle\rangle) \]
\[ = \bglue(\erase{\wid N}, \langle\rangle) \]
\[ = \bglue(|\wid N|, \bunglue (\wid N)) \]
\[ = \wid N \]

