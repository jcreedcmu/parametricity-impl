\begin{lemma}[Substitution Extension]
\label{lemma.subst.extension}
A substitution extends by the identity on a fresh variable, as follows.
  \begin{itemize}
  \item If $\wid \Delta \wprov \wid \theta : \wid \Gamma$ and $\wid\Gamma \wprov \wid A : \wid\rtype$, then
$(\wid \Delta, x : \wid\theta\wid A) \wprov \wid \theta\wsub{x/x} : (\wid \Gamma, x : \wid A)$.
  \item If $\wid \Delta \wprov \wid \theta : \wid \Gamma$ and $\rdemote{\wid\Gamma} \wprov \wid A : \wid\rtype$, then
$(\wid \Delta, x :: \rdemote{\wid\theta}\wid A) \wprov \wid \theta\wsub{x/_{::} x} : (\wid \Gamma, x :: \wid A)$.
  \item If $\wid \Delta \wprov \wid \theta : \wid \Gamma$ and $\demote{\wid\Gamma} \nprov \nar A : \nar\rtype$, then
$(\wid \Delta, x \div \demote{\wid\theta}\nar A) \wprov \wid \theta\wsub{x/_{\div} x} : (\wid \Gamma, x \div \nar A)$.
  \item If $\nar \Delta \nprov \nar \theta : \nar \Gamma$ and $\nar\Gamma \nprov \nar A : \nar\rtype$, then
$(\nar \Delta, x \div \nar\theta\nar A) \nprov \nar \theta\nsub{x/_{\div} x} : (\nar \Gamma, x \div \nar A)$.
  \item If $\nar \Delta \nprov \nar \theta : \nar \Gamma$ and $\ups\nar\Gamma \wprov \wid A : \wid\rtype$, then
$(\nar \Delta, x :: (\ups\nar\theta)\wid A) \nprov \nar \theta\nsub{x/_{::} x} : (\nar \Gamma, x :: \wid A)$.
  \end{itemize}
\end{lemma}

\begin{proof}

\cqed
\end{proof}

\begin{lemma}[Substitution Commutation]
\label{lemma.subst.commutation}
Single substitution commutes with simultaneous substitution. Supposing $x$ is fresh for $\wid\theta$ and $\nar\theta$,
\[\wid\theta(\wsub{\wid M/x}\wid J) = \wsub{\wid\theta\wid M/x}(\wid\theta\wid J)
\qquad
\nar\theta(\nsub{\nar M/_{\div} x}\nar J) = \nsub{\nar\theta\nar M/_{\div} x}(\nar\theta\nar J)\]
\end{lemma}

\begin{proof}

\cqed
\end{proof}


\subsection{Substitution Theorem}
Let $\wid J$ range over any wide judgment ($\wid A : \wid \rtype$, $\wid M : \wid A$) and
$\nar J$ over any narrow judgment ($\nar A : \nar \rtype$, $\nar M : \nar A$). Substitution into judgments
is the obvious thing: just apply the substitution to all its parts. Then
\begin{theorem}[Substitution Theorem]\ %
  \begin{enumerate}
  \item $\wid \Delta \wprov \wid \theta : \wid \Gamma$ and $\wid \Gamma \wprov  \wid J$, then $\wid \Delta \wprov \wid \theta \wid J$.
  \item $\nar \Delta \nprov \nar \theta : \nar \Gamma$ and $\nar \Gamma \nprov  \nar J$, then $\nar \Delta \nprov \nar \theta \nar J$.
  \end{enumerate}
\end{theorem}
\begin{proof}
By induction on the derivation of the judgment being substituted into.
For the purposes of this theorem, we treat $\wid\Gamma \wprov \wid M : \wid A$ as presupposing
$\wprov \wid \Gamma \rctx$ and $\wid\Gamma \wprov \wid A : \rtype$, and similarly for other judgments.

\begin{itemize}
\item[Case:] Fiber type.
\[
\nar \Delta \nprov \nar \theta : \nar \Gamma
\qquad
\begin{prooftree}
\ups\nar \Gamma \wprov \wid A : \wid\rtype \quad \nar \Gamma \nprov \nar M : \erase {\wid A}
\justifies
\nar \Gamma \nprov \pp {\nar M} {\wid A} : \nar\rtype
\end{prooftree}\]
Our goal is to show
\[ \nar\Delta \nprov \nar\theta(\pp{\nar M}{\wid A}) : \nar\rtype\]
which by the definition of substitution is
\[ \nar\Delta \nprov \pp{\nar\theta\nar M}{(\ups\nar\theta)\wid A} : \nar\rtype\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\ups{\nar \Delta} \wprov \ups{\nar \theta} : \ups{\nar \Gamma}\]
Then by induction hypothesis and the definition of substitution, we know
\[\ups{\nar\Delta} \wprov (\ups\nar\theta)\wid A : \wid\rtype\]
\[\nar\Delta \nprov \nar\theta\nar M : \nar\theta\erase{\wid A}\]
By Lemma~\ref{lemma.inclusion.erase.compat} we have
\[\nar\Delta \nprov \nar\theta\nar M : \erase{(\ups\nar\theta)\wid A}\]
so we can construct
\[\begin{prooftree}
\ups{\nar \Delta} \wprov (\ups\nar\theta)\wid A : \wid\rtype \quad
\nar \Delta \nprov \nar\theta\nar M : \erase {(\ups\nar\theta)\wid A}
\justifies
\nar \Delta \nprov \pp {\nar\theta\nar M} {(\ups\nar\theta)\wid A} : \nar\rtype
\end{prooftree}\]
and we are done.

\item[Case:] Fiber type introduction.
\[
\nar \Delta \nprov \nar \theta : \nar \Gamma
\qquad
\begin{prooftree}
\ups {\nar \Gamma} \wprov \wid M : \wid A
\justifies
\nar \Gamma \nprov \{\wid M\} : \pp  {\erase{\wid M}} {\wid A}
\end{prooftree}\]
Our goal is to show
\[ \nar\Delta \nprov \nar\theta\{\wid M\} : \nar\theta(\pp{\erase{\wid M}}{\wid A})\]
which by the definition of substitution is
\[ \nar\Delta \nprov \{(\ups\nar\theta)\wid M\} : \pp{\nar\theta\erase{\wid M}}{(\ups\nar\theta)\wid A}\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\ups{\nar \Delta} \wprov \ups{\nar \theta} : \ups{\nar \Gamma}\]
so by induction hypothesis we know
\[\ups{\nar\Delta} \wprov (\ups\nar\theta)\wid M : (\ups\nar\theta)\wid A\]
and therefore can construct
\[\begin{prooftree}
\ups {\nar \Delta} \wprov (\ups\nar\theta)\wid M : (\ups\nar\theta)\wid A
\justifies
\nar \Delta \nprov \{(\ups\nar\theta)\wid M\} : \pp  {\erase{(\ups\nar\theta)\wid M}} {(\ups\nar\theta)\wid A}
\end{prooftree}\]
By Lemma~\ref{lemma.inclusion.erase.compat} the type here is the same as $\pp{\nar\theta\erase{\wid M}}{(\ups\nar\theta)\wid A}$,
and we are done.

\item[Case:] Fiber type elimination.
\[
\wid \Delta \wprov \wid \theta : \wid \Gamma
\qquad
\begin{prooftree}
\demote{\wid\Gamma} \nprov \nar M : \erase{\wid A} \quad
\promote{\wid\Gamma} \nprov \nar N : \pp{\nar M}{\wid A}
\justifies
\wid\Gamma \wprov \epair{\nar M}{\nar N} : \wid A
\end{prooftree}\]
Our goal is to show
\[ \wid\Delta \wprov \wid\theta(\epair{\nar M}{\nar N}) : \wid\theta \wid A\]
which by the definition of substitution is
\[ \wid\Delta \wprov \epair{\demote{\wid\theta}\nar M}{\promote{\wid\theta}\nar N} : \wid\theta \wid A\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\demote{\wid \Delta} \nprov \demote{\wid \theta} : \demote{\wid \Gamma}\]
\[\promote{\wid \Delta} \nprov \promote{\wid \theta} : \promote{\wid \Gamma}\]
Then by induction hypothesis and and the definition of substitution, we know
\[\demote{\wid\Delta} \nprov \demote{\wid\theta} \nar M : \demote{\wid\theta}\erase{\wid A}\]
\[\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \pp{\promote{\wid\theta} \nar M}{\rpromote{\wid\theta}\wid A}\]
By Lemma~\ref{lemma.demotion.erase.compat} we have
\[\demote{\wid\Delta} \nprov \demote{\wid\theta} \nar M : \erase{\wid\theta \wid A}\]
and by Corollary~\ref{corollary.indifference}, we have
\[\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \pp{\demote{\wid\theta} \nar M}{{\wid\theta}\wid A}\]
so we can construct
\[\begin{prooftree}
\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar M : \erase{\wid\theta \wid A} \quad
\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \pp{\demote{\wid\theta}\nar M}{\wid\theta \wid A}
\justifies
\wid\Delta \wprov \epair{\demote{\wid\theta}\nar M}{\promote{\wid\theta}\nar N} : \wid\theta \wid A
\end{prooftree}\]
and we are done.

\item[Case:] Glue type.
\[
\wid \Delta \wprov \wid \theta : \wid \Gamma
\qquad
\begin{prooftree}
\demote{\wid\Gamma} \nprov \nar A : \nar\rtype \qquad
\promote{\wid\Gamma}, x \div \nar A \nprov \nar B : \nar\rtype
\justifies
\wid\Gamma \wprov \gg(x : \nar A).\nar B : \wid\rtype
\end{prooftree}\]
Our goal is to show
\[ \wid\Delta \wprov \wid\theta(\gg(x : \nar A).\nar B) : \wid\rtype\]
which by the definition of substitution is
\[ \wid\Delta \wprov \gg(x : \demote{\wid\theta}\nar A).\promote{\wid\theta}\nar B : \wid\rtype\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\demote{\wid \Delta} \nprov \demote{\wid \theta} : \demote{\wid \Gamma}\]
\[\promote{\wid \Delta} \nprov \promote{\wid \theta} : \promote{\wid \Gamma}\]
and by Lemma~\ref{lemma.subst.extension} the latter extends to
\[(\promote{\wid \Delta}, x \div \promote{\wid\theta}\nar A) \nprov \promote{\wid \theta}\nsub{x/_{\div} x} : (\promote{\wid \Gamma}, x \div \nar A)\]
Then by induction hypothesis we know
\[\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar A : \nar\rtype\]
\[\promote{\wid\Delta}, x \div \promote{\wid\theta}\nar A \nprov \promote{\wid\theta}\nar B : \nar\rtype\]
By Corollary~\ref{corollary.indifference} applied to the first premise, $\promote{\wid\theta}\nar A = \demote{\wid\theta}\nar A$, so
\[\promote{\wid\Delta}, x \div \demote{\wid\theta}\nar A \nprov \promote{\wid\theta}\nar B : \nar\rtype\]
so we can construct
\[\begin{prooftree}
\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar A : \nar\rtype \qquad
\promote{\wid\Delta}, x \div \demote{\wid\theta}\nar A \nprov \promote{\wid\theta}\nar B : \nar\rtype
\justifies
\wid\Delta \wprov \gg(x : \demote{\wid\theta}\nar A).\promote{\wid\theta}\nar B : \wid\rtype
\end{prooftree}\]
and we are done.

\item[Case:] Glue type introduction.
\[
\wid \Delta \wprov \wid \theta : \wid \Gamma
\qquad
\begin{prooftree}
\demote{\wid\Gamma} \nprov \nar M : \nar A \qquad
\promote{\wid\Gamma} \nprov \nar N : \nsub{\nar M/_{\div}x}\nar B
\justifies
\wid\Gamma \wprov \bglue(\nar M, \nar N) : \gg(x : \nar A).\nar B
\end{prooftree}\]
Our goal is to show
\[ \wid\Delta \wprov \wid\theta(\bglue(\nar M, \nar N)) : \wid\theta(\gg(x : \nar A).\nar B)\]
which by the definition of substitution is
\[ \wid\Delta \wprov \bglue(\demote{\wid\theta}\nar M, \promote{\wid\theta}\nar N) : \gg(x : \demote{\wid\theta}\nar A).\promote{\wid\theta}\nar B\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\demote{\wid \Delta} \nprov \demote{\wid \theta} : \demote{\wid \Gamma}\]
\[\promote{\wid \Delta} \nprov \promote{\wid \theta} : \promote{\wid \Gamma}\]
Then by induction hypothesis we know
\[\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar M : \demote{\wid\theta}\nar A\]
\[\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \promote{\wid\theta}(\nsub{\nar M/_{\div}x}\nar B)\]
By Lemma~\ref{lemma.subst.commutation}, the type in the second of these is
$\nsub{\promote{\wid\theta}\nar M/_{\div}x}(\promote{\wid\theta}\nar B)$, and by
Corollary~\ref{corollary.indifference} applied to the first premise we may rewrite
$\promote{\wid\theta}\nar M$ as $\demote{\wid\theta}\nar M$, giving
\[\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \nsub{\demote{\wid\theta}\nar M/_{\div}x}(\promote{\wid\theta}\nar B)\]
so we can construct
\[\begin{prooftree}
\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar M : \demote{\wid\theta}\nar A \qquad
\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \nsub{\demote{\wid\theta}\nar M/_{\div}x}(\promote{\wid\theta}\nar B)
\justifies
\wid\Delta \wprov \bglue(\demote{\wid\theta}\nar M, \promote{\wid\theta}\nar N) : \gg(x : \demote{\wid\theta}\nar A).\promote{\wid\theta}\nar B
\end{prooftree}\]
and we are done.

\item[Case:] Glue type elimination.
\[
\nar \Delta \nprov \nar \theta : \nar \Gamma
\qquad
\begin{prooftree}
\ups\nar\Gamma \wprov \wid M : \gg(x : \nar A).\nar B
\justifies
\nar\Gamma \nprov \bunglue \wid M : \nsub{\erase{\wid M}/_{\div}x}\nar B
\end{prooftree}\]
Our goal is to show
\[ \nar\Delta \nprov \nar\theta(\bunglue \wid M) : \nar\theta(\nsub{\erase{\wid M}/_{\div}x}\nar B)\]
which by the definition of substitution, Lemma~\ref{lemma.subst.commutation},
and Lemma~\ref{lemma.inclusion.erase.compat} is
\[ \nar\Delta \nprov \bunglue((\ups\nar\theta)\wid M) : \nsub{\erase{(\ups\nar\theta)\wid M}/_{\div}x}(\nar\theta\nar B)\]
By Lemma~\ref{lemma.operations.subst}, we have
\[\ups{\nar \Delta} \wprov \ups{\nar \theta} : \ups{\nar \Gamma}\]
so by induction hypothesis and the definition of substitution we know
\[\ups{\nar\Delta} \wprov (\ups\nar\theta)\wid M : \gg(x : \demote{(\ups\nar\theta)}\nar A).\promote{(\ups\nar\theta)}\nar B\]
By Lemma~\ref{lemma.operation.identities} both $\demote{(\ups\nar\theta)}$ and $\promote{(\ups\nar\theta)}$ are $\nar\theta$, so
\[\ups{\nar\Delta} \wprov (\ups\nar\theta)\wid M : \gg(x : \nar\theta\nar A).\nar\theta\nar B\]
and therefore we can construct
\[\begin{prooftree}
\ups\nar\Delta \wprov (\ups\nar\theta)\wid M : \gg(x : \nar\theta\nar A).\nar\theta\nar B
\justifies
\nar\Delta \nprov \bunglue((\ups\nar\theta)\wid M) : \nsub{\erase{(\ups\nar\theta)\wid M}/_{\div}x}(\nar\theta\nar B)
\end{prooftree}\]
and we are done.
\end{itemize}



\cqed
\end{proof}




