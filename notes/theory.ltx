\subsection{Substitution}


\begin{lemma}\ %
\label{substitution.modification}
  \begin{enumerate}
  \item If $\wid \Gamma \wprov \wid \theta : \wid \Delta$, then $\demote{\wid \Gamma} \nprov \demote{\wid \theta} : \demote{\wid \Delta}$.
  \item If $\wid \Gamma \wprov \wid \theta : \wid \Delta$, then $\promote{\wid \Gamma} \nprov \promote{\wid \theta} : \promote{\wid \Delta}$.
  \item If $\nar \Gamma \nprov \nar \theta : \nar \Delta$, then $\ups{\nar \Gamma} \wprov \ups{\nar \theta} : \ups{\nar \Delta}$.
  \end{enumerate}
\end{lemma}

\begin{proof}\ %
  \begin{itemize}
  \item Case of demotion of ordinary variable. Use
Lemma~\ref{erase.term} to do
\[
\begin{prooftree}
\wid \Gamma \wprov \wid M : \wid A
\justifies
\wid \Gamma \wprov [\wid M/ x] : (\wid \Gamma, x : \wid A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\demote{\wid \Gamma} \wprov \erase{\wid M} : \erase{\wid A}
\justifies
\demote{\wid \Gamma} \nprov [|\wid M|/_{\div} x] : (\demote{\wid \Gamma}, x \div |\wid A|)
\end{prooftree}
\]
  \item Case of promotion of ordinary variable. Use
Lemma~\ref{promotion.weakening} to do
\[
\begin{prooftree}
\wid \Gamma \wprov \wid M : \wid A
\justifies
\wid \Gamma \wprov [\wid M/ x] : (\wid \Gamma, x : \wid A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\ups (\promote{\wid \Gamma}) \wprov \wid M : \wid A
\justifies
\promote{\wid \Gamma} \nprov [\wid M/_{::} x] : (\promote{\wid \Gamma}, x :: \wid A)
\end{prooftree}
\]
  \item Case of demotion of weak variable. Simply do
\[
\begin{prooftree}
\demote{\wid \Gamma} \nprov \nar M : \nar A
\justifies
\wid \Gamma \wprov [\nar M/_{\div} x] : (\wid \Gamma, x \div \nar A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\demote{\wid \Gamma} \nprov \nar M : \nar A
\justifies
\demote{\wid \Gamma} \nprov [\nar M/_{\div} x] : (\demote{\wid \Gamma}, x \div \nar A)
\end{prooftree}
\]
  \item Case of promotion of weak variable. Use
Lemma~\ref{narrow.weakening} to do
\[
\begin{prooftree}
\demote{\wid \Gamma} \nprov \nar M : \nar A
\justifies
\wid \Gamma \wprov [\nar M/_{\div} x] : (\wid \Gamma, x \div \nar A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\promote{\wid \Gamma} \nprov \nar M : \nar A
\justifies
\promote{\wid \Gamma} \nprov [\nar M/_{\div} x] : (\promote{\wid \Gamma}, x \div \nar A)
\end{prooftree}
\]
  \item Case of demotion of strong variable. Simply do
\[
\begin{prooftree}
\rdemote{\wid \Gamma} \wprov \wid M : \wid A
\justifies
\wid \Gamma \wprov [\wid M/_{::} x] : (\wid \Gamma, x :: \wid A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\ups (\demote{\wid \Gamma}) \wprov \wid M : \wid A
\justifies
\demote{\wid \Gamma} \nprov [\wid M/_{::} x] : (\demote{\wid \Gamma}, x :: \wid A)
\end{prooftree}
\]
  \item Case of promotion of strong variable. Use
Lemma~\ref{demotion.weakening} and Lemma~\ref{promotion.weakening} to do
\[
\begin{prooftree}
\rdemote{\wid \Gamma} \wprov \wid M : \wid A
\justifies
\wid \Gamma \wprov [\wid M/_{::} x] : (\wid \Gamma, x :: \wid A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\ups (\promote{\wid \Gamma}) \wprov \wid M : \wid A
\justifies
\promote{\wid \Gamma} \nprov [\wid M/_{::} x] : (\promote{\wid \Gamma}, x :: \wid A)
\end{prooftree}
\]
  \item Case of inclusion of weak variable. Use Lemma~\ref{include.demote.eq.orig} to do
\[
\begin{prooftree}
\nar \Gamma \nprov \nar M : \nar A
\justifies
\nar \Gamma \nprov [\nar M/_{\div} x] : (\nar \Gamma, x \div \nar A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\demote{(\ups \nar \Gamma)} \nprov \nar M : \nar A
\justifies
\ups \nar \Gamma \wprov [\nar M/_{\div} x] : (\ups \nar \Gamma, x \div \nar A)
\end{prooftree}
\]
  \item Case of inclusion of strong variable. Use Lemma~\ref{include.demote.eq.orig} to do
\[
\begin{prooftree}
\ups \nar \Gamma \wprov \wid M : \wid A
\justifies
\nar \Gamma \nprov [\wid M/_{::} x] : (\nar \Gamma, x :: \wid A)
\end{prooftree}
\quad\mapsto\quad
\begin{prooftree}
\rdemote{(\ups \nar \Gamma)} \wprov \wid M : \wid A
\justifies
\ups \nar \Gamma \wprov [\wid M/_{::} x] : (\ups \nar \Gamma, x :: \wid A)
\end{prooftree}
\]
  \end{itemize}
\cqed
\end{proof}




\begin{lemma}\ %
\label{operation.substitution.commute}
\begin{itemize}
\item $\demote{\wid\theta}\demote{\wid\Gamma} = \demote{(\wid\theta \wid\Gamma)}$
\item $(\ups {\nar\theta})(\ups {\nar\Gamma}) = \ups{(\nar\theta \nar\Gamma)}$
\end{itemize}

\end{lemma}

\begin{proof}
\textcolor{red}{XXX THIS PROOF NO LONGER VALID}
Case split by how we construct the context.
  \begin{itemize}
  \item $ ({\wid\Gamma}, x : \wid A)$.
Our goal is to show
\[\rdemote{\wid\theta}\rdemote{({\wid\Gamma}, x : \wid A)} = \rdemote{(\wid\theta ({\wid\Gamma}, x : \wid A))}\]
which by definitions and Lemma~\ref{include.demote.eq.orig} is
\[(\rdemote{\wid\theta}\rdemote{\wid\Gamma}, x  \div \demote{\wid\theta}|\wid A|) = (\rdemote{(\wid\theta {\wid\Gamma})}, x \div \erase{\wid\theta\wid A})\]
By induction hypothesis and Lemma~\ref{demotion.erase.compat}, this is so.
\item
$ ({\wid\Gamma}, x \div \nar A)$.
Our goal is to show
\[\rdemote{\wid\theta}\rdemote{({\wid\Gamma}, x \div \nar A)} = \rdemote{(\wid\theta ({\wid\Gamma}, x \div \nar A))}\]
which by definitions and Lemma~\ref{include.demote.eq.orig} is
\[ (\rdemote{\wid\theta}\rdemote{\wid\Gamma}, x \div \demote{\wid\theta}\nar A) = (\rdemote{(\wid \theta {\wid\Gamma})}, x \div \demote{\wid\theta}\nar A)\]
By the induction hypothesis, this is so.
\item $({\wid\Gamma}, x :: \wid A)$.
Our goal is to show
\[\rdemote{\wid\theta}\rdemote{({\wid\Gamma}, x :: \wid A)} = \rdemote{(\wid\theta ({\wid\Gamma}, x :: \wid A))}\]
which by definitions and Lemma~\ref{include.demote.eq.orig} is
\[(\rdemote{\wid\theta}\rdemote{\wid\Gamma}, x :: \rdemote{\wid\theta}\wid A) =  (\rdemote{(\wid\theta{\wid\Gamma})}, x :: \rdemote{\wid\theta}\wid A)\]
By the induction hypothesis, this is so.
  \end{itemize}
\cqed
\end{proof}

\begin{theorem}[Substitution Theorem]\ %
  \begin{enumerate}
  \item If $\wid \Delta \wprov \wid \theta : \wid \Gamma$ and $\wid \Gamma \wprov  \wid J$, then
$\wid \Delta\wprov \wid \theta \wid J$.
  \item If $\nar \Delta \nprov \nar \theta : \nar \Gamma$ and $\nar \Gamma \nprov  \nar J$, then
$\nar \Delta\nprov \nar \theta \nar J$.
  \end{enumerate}
\end{theorem}

\begin{proof}\ %
  \begin{itemize}
\item Consider the case of
\[
\begin{prooftree}
\ups\nar \Gamma \wprov \wid A : \wid\rtype \quad \nar \Gamma \nprov \nar M : \erase {\wid A}
\justifies
\nar \Gamma \nprov \pp {\nar M} {\wid A} : \nar\rtype
\end{prooftree}
\]
We suppose $\nar \Delta \nprov \nar \theta : \nar \Gamma$.
By
Lemma~\ref{substitution.modification} we have
\[\ups{\nar\Delta}  \wprov \ups{\nar\theta} : \ups{\nar\Gamma}\]
Now apply the induction hypothesis to get
\[\ups\nar \Delta \wprov (\ups{\nar\theta})  \wid A : \wid\rtype \qquad \nar \Delta \nprov {\nar\theta} \nar M : \nar \theta \erase {\wid A}\]

Now thanks to Lemmas~\ref{demotion.erase.compat} and~\ref{include.demote.eq.orig}, we can derive
\[
\begin{prooftree}
\ups\nar \Gamma \wprov (\ups\nar\theta)\wid A : \wid\rtype \quad \nar \Gamma \nprov \nar\theta\nar M : \erase {(\ups\nar\theta)\wid A}
\justifies
\nar \Gamma \nprov \pp {\nar\theta\nar M} {(\ups\nar\theta)\wid A} : \nar\rtype
\end{prooftree}
\]
\item Consider the case of
\[\begin{prooftree}
\demote{\wid\Gamma} \nprov \nar M : \erase{\wid A} \quad
\promote{\wid\Gamma} \nprov \nar N : \pp{\nar M}{\wid A}
\justifies
\wid\Gamma \wprov \epair{\nar M}{\nar N} : \wid A
\end{prooftree}\]
We suppose $\wid \Delta \wprov \wid \theta : \wid \Gamma$. By
Lemma~\ref{substitution.modification} we have
\[\demote{\wid\Delta}  \nprov \demote{\wid\theta} : \demote{\wid\Gamma}\qquad
\promote{\wid\Delta}  \nprov \promote{\wid\theta} : \promote{\wid\Gamma}\]
Now apply the induction hypothesis to get
\[\demote{\wid\Delta} \nprov  \demote{\wid\theta}\nar M :  \demote{\wid\theta}\erase{\wid A} \qquad
\promote{\wid\Delta} \nprov \promote{\wid\theta} \nar N :\promote{\wid\theta} \pp{\nar M}{\wid A}\]

Now we can derive
\[\begin{prooftree}
\demote{\wid\Delta} \nprov \demote{\wid\theta}\nar M : \erase{\wid \theta\wid A} \quad
\promote{\wid\Delta} \nprov \promote{\wid\theta}\nar N : \pp{\demote{\wid\theta}\nar M}{\wid \theta\wid A}
\justifies
\wid\Delta \wprov \epair{ \demote{\wid\theta}\nar M}{\promote{\wid\theta}\nar N} : {\wid\theta}\wid A
\end{prooftree}\]
\textcolor{red}{CONFUSED HERE}
  \item
\textcolor{red}{XXX this is structurally correct but I need to account for contextual context validity,
and swap $\Gamma$ and $\Delta$}
Consider the case of
\[  \wid\theta (\wid \Gamma, x \div \nar A) =   (\wid\theta\wid \Gamma, x \div \demote{\wid\theta}\nar A)\]
We have
\[\wid \Delta \wprov \wid \theta : \wid \Delta'\]
\[\begin{prooftree}
\wid \Delta'\wprov {\wid\Gamma} \rctx \qquad \wid \Delta',\demote {\wid \Gamma} \nprov \nar A : \rtype
\justifies
\wid \Delta' \wprov ({\wid\Gamma}, x \div \nar A)\rctx
\end{prooftree}\]
and we want to show
\[\wid \Delta \wprov (\wid\theta\wid \Gamma, x \div \demote{\wid\theta}\nar A) \rctx\]
We apply Lemma~\ref{substitution.modification} to get
\[\demote{\wid\Delta}  \nprov \demote{\wid\theta} : \demote{\wid\Delta'}\]
and then apply the induction hypothesis to get
\[  \demote{\wid\Delta} , \demote{\wid\theta}\demote{\wid\Gamma} \nprov \demote{\wid\theta} \nar A : \rtype\]
and by Lemma~\ref{operation.substitution.commute} we have
\[
\begin{prooftree}
\wid \Delta \wprov {\wid \theta\wid \Gamma} \rctx \qquad \demote{\wid \Delta}, \demote {(\wid \theta\wid \Gamma)} \nprov \demote{\wid\theta} \nar A : \rtype
\justifies
\wid \Delta \wprov ({\wid \theta\wid \Gamma}, x \div \demote{\wid\theta} \nar A)\rctx
\end{prooftree}
\]
  \item Consider the case of
\[  \wid\theta (\wid \Gamma, x :: \wid A) =   (\wid\theta\wid \Gamma, x :: \rdemote{\wid\theta}\wid A)\]
We have
\[\wid \Delta \wprov \wid \theta : \wid \Delta'\]
\[
\begin{prooftree}
\wid \Delta' \wprov {\wid\Gamma} \rctx \qquad \rdemote{\wid\Delta'} ,\rdemote{\wid\Gamma} \wprov \wid A : \rtype
\justifies
\wid \Delta' \wprov ({\wid\Gamma}, x :: \wid A)\rctx
\end{prooftree}
\]
and we want to show
\[\wid \Delta \wprov (\wid \theta {\wid\Gamma}, x :: \rdemote{\wid \theta}\wid A)\rctx\]
We apply Lemma~\ref{substitution.modification} to get
\[\rdemote{\wid\Delta}  \nprov \rdemote{\wid\theta} : \rdemote{\wid\Delta'}\]
and then apply the induction hypothesis to get
\[  \rdemote{\wid\Delta} , \rdemote{\wid\theta}\rdemote{\wid\Gamma} \nprov \rdemote{\wid\theta} \wid A : \rtype\]
and by Lemma~\ref{operation.substitution.commute} we have
\[
\begin{prooftree}
\wid \Delta \wprov {\wid \theta \wid\Gamma} \rctx \qquad \rdemote{\wid \Delta} , \rdemote{(\wid \theta \wid\Gamma)} \wprov \rdemote{\wid \theta}\wid A : \rtype
\justifies
\wid \Delta  \wprov ({\wid \theta \wid\Gamma}, x :: \rdemote{\wid \theta}\wid A)\rctx
\end{prooftree}
\]

  \end{itemize}
\cqed
\end{proof}


\section{Interesting Theorems}

\subsection{Fracture}
If $\wid \Gamma\wprov \wid A : \wid\rtype$ then we have an isomorphism
\[\wid \Gamma\wprov \wid A \cong \gg(x \div \erase{\wid A}) . \pp {x} {\wid A}\]
\[\wid \Gamma\wprov \mathsf{fore} : \wid A \to \gg(x \div \erase{\wid A}) . \pp {x} {\wid A}\]
\[ \mathsf{fore} = \lambda a. \bglue(a, \{ a\})\]
\[\wid \Gamma\wprov \mathsf{back} :  \gg(x \div \erase{\wid A}) . \pp {x} {\wid A} \to \wid A\]
\[ \mathsf{back} = \lambda g. \epair{g}{ \bunglue(g)}\]

\subsection{Fracture With Internalized Erasure}
If $\wid \Gamma\wprov \wid A : \wid\rtype$ then we have an isomorphism
\[\wid \Gamma\wprov \wid A \cong \gg(x \div \wipe \wid A) . \pp {\buse(x)} {\wid A}\]
This is sort of the ``$e^{\pi i} = -1$'' of this type system, in the sense that it nicely ties together the three type constructors
$\gg$ and $\wipe$ and $\pp {\dash}{\dash}$.
\[\wid \Gamma\wprov \mathsf{fore} : \wid A \to \gg(x \div \wipe \wid A) . \pp {\buse(x)} {\wid A}\]
\[ \mathsf{fore} = \lambda a. \bglue(\bmake(a), \{ a\})\]
\[\wid \Gamma\wprov \mathsf{back} :  \gg(x \div \wipe \wid A) . \pp {\buse(x)} {\wid A} \to \wid A\]
\[ \mathsf{back} = \lambda g. \epair{\buse(g)}{ \bunglue(g)}\]
\subsection{The Nondependent Function Type}
If
\[ \nprov \nar \Gamma \rctx \qquad \ups \nar\Gamma \wprov \wid A : \rtype \qquad \ups \nar\Gamma \wprov \wid B : \rtype \qquad
\nar \Gamma \nprov \nar f : \erase{\wid A \to \wid B}\]
then there exists an isomorphism
\[\nar \Gamma \nprov \pp {\nar f} {\wid A \to \wid B}  \cong ( a :  \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\  a} {\wid B} \]
Here is the construction:
\[ \nar \Gamma \prov \mathsf{fore} : (f' : \pp {\nar f} {\wid A \to \wid B}) (a : \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\ a} {\wid B} \]
\[\mathsf{fore} = \lambda f'.\lambda a.\lambda a'.  \{(\epair {\nar f} {f'})\ (\epair { a} {a'})\}\]
\[\nar \Gamma \prov \mathsf{back} : (k : (a : \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\ a} {\wid B}) \to \pp {\nar f} {\wid A \to \wid B} \]
\[\mathsf{back} = \lambda k. \{\lambda x . (\epair {{\nar f}\ x} {k\ x\ \{x\}})\}\]
Let's typecheck these. Make some abbreviations
\[\nar \Gamma_1 = (\nar \Gamma, f' \div \pp {\nar f} {\wid A \to \wid B}, a \div \erase{\wid A}, a' \div \pp {  a} {\wid A})\]
\[\nar \Gamma_2 = (\nar\Gamma, k \div (a : \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\ a} {\wid B})\]
\[\nar \Gamma_3 = (\nar\Gamma_2, x :: \wid A)\]
For $\mathsf{fore}$, we can just prove
\[
\begin{prooftree}
\[
\[
\[
\justifies
\nar\Gamma_1 \nprov {\nar f}  : \erase{\wid A \to \wid B}
\]
\[
\justifies
\nar\Gamma_1 \nprov f' :  \pp {\nar f} {\wid A \to \wid B}
\]
\justifies
\ups \nar\Gamma_1 \wprov \epair {\nar f} {f'} :  {\wid A \to \wid B}
\]
\[
\[
\justifies
\nar\Gamma_1 \nprov { a}  :  \erase{\wid A}
\]
\[
\justifies
\nar\Gamma_1 \nprov a' :  \pp { a} {\wid A}
\]
\justifies
\ups \nar\Gamma_1 \wprov \epair { a} {a'} :  \wid A
\]
\justifies
\ups \nar\Gamma_1 \wprov (\epair {\nar f} {f'})\ (\epair { a} {a'}) :  \wid B
\]
\justifies
\nar \Gamma, f' \div \pp {\nar f} {\wid A \to \wid B}, a \div \erase{\wid A}, a' \div \pp {  a} {\wid A} \nprov \{(\epair {\nar f} {f'})\ (\epair { a} {a'})\} : \pp {\nar f\ a} {\wid B}
\end{prooftree}
\]
For $\mathsf{back}$, we can take
\[
\begin{prooftree}
\[
\[
\justifies
\nar\Gamma_3 \nprov  k : (a : \erase{\wid A}) (a' : \pp { a}{\wid A}) \to \pp {\nar f\ a}{\wid B}
\]
\[
\justifies
\nar\Gamma_3 \nprov  x : \erase{\wid A}
\]
\justifies
\nar\Gamma_3 \nprov  {k\ x} : \pp x{\wid A} \to  \pp {\nar f\ x}{\wid B}
\]
\[
\[
\justifies
\ups \nar\Gamma_3 \wprov  x : {\wid A}
\]
\justifies
\nar\Gamma_3 \nprov  {\{x\}} : \pp x{\wid A}
\]
\justifies
\nar\Gamma_3 \nprov  {k\ x\ \{x\}} : \pp {\nar f\ x}{\wid B}
\end{prooftree}
\]
and insert it into
\[
\begin{prooftree}
\[
\[
\[
\[
\justifies
\nar\Gamma_2 \nprov f : \erase{\wid A \to \wid B}
\]
\[
\justifies
\nar\Gamma_2, x \div \erase{\wid A} \nprov x : \erase{\wid A}
\]
\justifies
\nar\Gamma_2, x \div \erase{\wid A} \nprov \nar f\ x : \erase{\wid B}
\]
\qquad
\[\vdots \justifies \nar\Gamma_2, x :: \wid A \nprov  {k\ x\ \{x\}} : \pp {\nar f\ x} {\wid B}\]
\justifies
\ups \nar\Gamma_2, x : \wid A \wprov \epair {\nar f\ x} {k\ x\ \{x\}} : \wid B
\]
\justifies
\ups \nar\Gamma_2 \wprov \lambda x . (\epair {\nar f\ x} {k\ x\ \{x\}}) : \wid A \to \wid B
\]
\justifies
\nar\Gamma, k \div (a : \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\ a} {\wid B} \nprov \{\lambda x . (\epair {\nar f\ x} {k\ x\ \{x\}})\} : \pp {\nar f} {\wid A \to \wid B}
\end{prooftree}
\]


\subsection{The Dependent Function Type}
This is very similar to the non-dependent case. The difference is we must substitute into $B$.
If
\[ \nprov \nar \Gamma \rctx \qquad \ups \nar\Gamma \wprov \wid A : \rtype \qquad \ups \nar\Gamma, x : \wid A \wprov \wid B : \rtype \qquad
\nar \Gamma \nprov \nar f : \erase{(x : \wid A) \to \wid B}\]
then there exists an isomorphism
\[\nar \Gamma \nprov \pp {\nar f} {(x : \wid A) \to \wid B}  \cong ( a :  \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\  a} {[(\epair a {a'})/x]\wid B} \]
Here is the construction:
\[ \nar \Gamma \prov \mathsf{fore} : (f' : \pp {\nar f} {(x : \wid A) \to \wid B}) (a : \erase{\wid A}) (a' : \pp {  a} {\wid A}) \to \pp {\nar f\ a} {\wid B} \]
\[\mathsf{fore} = \lambda f'.\lambda a.\lambda a'.  \{(\epair {\nar f} {f'})\ (\epair { a} {a'})\}\]

\subsection{The Universe}
For any type
\[\nar \Gamma \nprov \nar A : \nar\rtype \]
we aim to show
\[\nar\Gamma \nprov \pp {\nar A} {\wid \rtype} \cong (\nar A \to \nar \rtype)\]
The maps are
\[\begin{array}{l}
 \mathsf{fore} : (p : \pp {\nar A} {\wid \rtype}) \to (\nar A \to \nar \rtype)\\
 \mathsf{fore} = \lambda p . \lambda a . \pp {a} {\epair {\nar A} p}\\
 \mathsf{back} : (R : \nar A \to \nar\rtype) \to  \pp {\nar A} {\wid \rtype}\\
 \mathsf{back} = \lambda R . \{ \gg (x : \nar A). R\ x\}
\end{array}\]
Let's check that these are well-typed.
Let's abbreviate
\[\nar\Gamma_1 = (\nar \Gamma, p \div \pp {\nar A} {\wid \rtype}, a \div \nar A)\]
\[\nar\Gamma_2 = (\nar \Gamma, R \div \nar A \to \nar \rtype)\]
Then we can prove $\mathsf{fore}$:
\[
\begin{prooftree}
\[
\[
\justifies
 \nar \Gamma_1\nprov {\nar A}  : \nar \rtype
\]
\[
\justifies
 \nar \Gamma_1\nprov  p : \pp {\nar A} {\wid \rtype}
\]
\justifies
\ups \nar \Gamma_1\wprov \epair{\nar A} p : \wid \rtype
\]
\[
\justifies
\nar \Gamma_1\nprov a : \nar A
\]
\justifies
\nar \Gamma_1\nprov \pp {a} {\epair {\nar A} p} : \nar \rtype
\end{prooftree}
\]
and $\mathsf{back}$:
\[
\begin{prooftree}
\[
\[
\justifies
\nar\Gamma_2 \nprov \nar A : \nar\rtype
\]
\[
\justifies
\nar\Gamma_2, x \div \nar A \nprov R\ x : \nar\rtype
\]
\justifies
\ups \nar\Gamma_2 \wprov   \gg (x : \nar A). R\ x :  \wid \rtype
\]
\justifies
\nar\Gamma_2 \nprov  \{ \gg (x : \nar A). R\ x\} :  \pp {\nar A} {\wid \rtype}
\end{prooftree}
\]

Now we want to check they're identities in both directions.
\subsubsection{First Zigzag}
We want to check that $\mathsf{fore} \o \mathsf{back}$ is the identity.
\[\begin{array}{rcl}
\mathsf{fore}\ (\mathsf{back}\ R) &=& \mathsf{fore} (\{ \gg (x : \nar A). R\ x\})\\
 &=&  \lambda a . \pp {a} {\epair {\nar A} \{ \gg (x : \nar A). R\ x\}} \\
 &\equiv_\beta&  \lambda a . \pp {a} {  \gg (x : \nar A). R\ x} \\
\end{array}\]
If this is to be equal to $R$, by extensionality we can check whether for all $a : \nar A$ we have
\[ R\ a = \pp {a} {  \gg (x : \nar A). R\ x} \]
Let's use univalence and demonstrate these are isomorphic. In the context $\nar \Gamma_2, a \div \nar A$, we define
\[\begin{array}{l}
 \mathsf{fore_1} : R\ a \to \pp {a} {  \gg (x : \nar A). R\ x}\\
 \mathsf{fore_1} = \lambda z . \{ \bglue(a, z)\} \\
 \mathsf{back_1} :  \pp {a} {  \gg (x : \nar A). R\ x} \to R\ a\\
 \mathsf{back_1} = \lambda w . \bunglue(\epair a w)\\
\end{array}\]
\subsubsection{Second Zigzag}
We want to check that $\mathsf{back} \o \mathsf{fore}$ is the identity.
\[\begin{array}{rcl}
\mathsf{back}\ (\mathsf{fore}\ p) &=&  \mathsf{back}\ (\lambda a . \pp {a} {\epair {\nar A} p})\\
&=&   \{ \gg (x : \nar A). (\lambda a . \pp {a} {\epair {\nar A} p})\ x\}\\
&=&   \{ \gg (x : \nar A).  \pp {x} {\epair {\nar A} p}\}\\
\end{array}\]

Now we want to show
\[p = \{ \gg (x : \nar A).  \pp {x} {\epair {\nar A} p}\}\]
at type $\pp {\nar A} {\wid \rtype}$ so $\eta$-expand both sides to
\[\epair {\nar A} p = \epair {\nar A} {\{ \gg (x : \nar A).  \pp {x} {\epair {\nar A} p}\}}\]
but the right-hand side $\beta$-reduces, so we get the equivalent equation
\[ \epair {\nar A} p = \gg(x : \nar A). \pp {x} {\epair {\nar A} p}\]

Let's use univalence and demonstrate these are isomorphic.
Let's abbreviate

\[\nar\Gamma_3 = (\nar \Gamma, p \div \pp {\nar A} {\wid \rtype})\]
\[\nar\Gamma_4 = (\nar \Gamma_3,  w ::  \gg(x : \nar A). \pp {x} {\epair {\nar A} p})\]

In the context $\nar \Gamma_3$, we define
\[\begin{array}{l}
 \mathsf{fore_2} :\epair {\nar A} p \to \gg(x : \nar A). \pp {x} {\epair {\nar A} p} \\
 \mathsf{fore_2} = \lambda z . \bglue(z, \{z\}) \\
 \mathsf{back_2} : ( \gg(x : \nar A). \pp {x} {\epair {\nar A} p} )\to \epair {\nar A} p\\
 \mathsf{back_2} = \lambda w . (\epair w {\bunglue(w)})\\
\end{array}\]

Let's typecheck these.

$\mathsf{fore_2}$:
\[
\begin{prooftree}
\[
\justifies
 \nar \Gamma_3, z \div  {\nar A}  \nprov  z :  \nar A
\]
\[
\[
\justifies
 \ups \nar \Gamma_3, z :: \epair {\nar A} p \wprov   z :  \epair {\nar A} p
\]
\justifies
 \nar \Gamma_3, z :: \epair {\nar A} p \nprov   \{z\} :  \pp {z} {\epair {\nar A} p}
\]
\justifies
\ups \nar \Gamma_3, z : \epair {\nar A} p \wprov  \bglue(z, \{z\}) : \gg(x : \nar A). \pp {x} {\epair {\nar A} p}
\end{prooftree}
\]

$\mathsf{back_2}$:
\[
\begin{prooftree}
\[
\justifies
 \nar \Gamma_3, w \div  \nar A \nprov w  :  \nar A
\]
\[
\[
\justifies
 \ups \nar \Gamma_4 \wprov w : \gg(x : \nar A). \pp {x} {\epair {\nar A} p}
\]
\justifies
 \nar \Gamma_4 \nprov \bunglue(w) :  \pp {w} {\epair {\nar A} p}
\]
\justifies
\ups \nar \Gamma_3, w : \gg(x : \nar A). \pp {x} {\epair {\nar A} p} \wprov \epair w {\bunglue(w)} :  \epair {\nar A} p
\end{prooftree}
\]

Let's check that these compose to the identity.
The composite $\mathsf{fore}_2 \o \mathsf{back}_2$ is
\[ (\lambda z . \bglue(z, \{z\})) \o ( \lambda w . (\epair w {\bunglue(w)}))\]
\[\equiv_\beta  \lambda w . \bglue(w, \{\epair w {\bunglue(w)}\}) \]
\[\equiv_\eta  \lambda w . \bglue(w,  {\bunglue(w)}) \]
\[\equiv_\eta  \lambda w . w \]

Something we need to be very careful about here is the substitution theorem: otherwise we would be substituting wide terms for narrow terms. The expression $\epair w {\bunglue(w)}$ must be erased when it's substituted for the first $z$.

The composite $\mathsf{back}_2 \o \mathsf{fore}_2$ is
\[ ( \lambda w . (\epair w {\bunglue(w)})) \o (\lambda z . \bglue(z, \{z\})) \]
\[= \lambda z . \epair {\textcolor{red}{\bglue(z, \{z\})}} {\bunglue(\bglue(z, \{z\}))}  \]
\[\equiv_\beta \lambda z . \epair {\textcolor{red}{\bglue(z, \{z\})}} { \{z\}}  \]
\[\equiv_\beta \lambda z . z  \]

Oops, that's wrong! I need to be careful in the same way. What should happen actually is:

\[ ( \lambda w . (\epair w {\bunglue(w)})) \o (\lambda z . \bglue(z, \{z\})) \]
\[= \lambda z . \epair z {\bunglue(\bglue(z, \{z\}))}  \]
\[\equiv_\beta \lambda z . \epair z { \{z\}}  \]
\[\equiv_\beta \lambda z . z  \]

