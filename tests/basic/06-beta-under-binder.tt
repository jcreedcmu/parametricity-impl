let Nat : U = (N : U) -> (N -> N) -> N -> N;
let zero : Nat = \N s z. z;
let five : Nat = \N s z. s (s (s (s (s z))));
let add  : Nat -> Nat -> Nat = \a b N s z. a N s (b N s z);
let Eq : (A : U) -> A -> A -> U
  = \A x y. (P : A -> U) -> P x -> P y;
let refl : (A : U)(x : A) -> Eq A x x
  = \A x P px. px;
let addZero : Eq Nat five (add zero five)
  = refl Nat five;
U
